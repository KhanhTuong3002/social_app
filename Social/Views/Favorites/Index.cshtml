@model List<Post>

<main id="site__main" class="2xl:ml-[--w-side]  xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex 2xl:gap-16 gap-12 max-w-[1065px] mx-auto" id="js-oversized">
        <div class="w-full min-w-[580px] max-w-[680px] mx-auto">
            @await Component.InvokeAsync("Stories")

            <div class="w-full min-w-[580px] flex-1 xl:space-y-6 space-y-3">

                @if (Model.Count == 0)
                {
                    <div class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1 dark:border-slate-800" style="width: 580px;">
                        Currently, there are no favorite posts available.
                    </div>
                }
                else
                {
                    @foreach (var post in Model)
                    {
                        <partial name="Home/_Post" model="post" view-data='new ViewDataDictionary(ViewData)
                                 {{"showAllComment",false}}' />
                    }
                }
            </div>
        </div>
        <div class="flex-1">
            <div class="lg:space-y-4 lg:pb-8 max-lg:grid sm:grid-cols-2 max-lg:gap-6">
                <div class="box p-5 px-6">
                    @await Component.InvokeAsync("SuggestedFriends")
                </div> <!-- Closing missing div -->
                <div class="box p-5 px-6">
                   @await Component.InvokeAsync("Hashtags")
                </div>
            </div>
        </div>
    </div>
</main>

<partial name="Modals/_CreateStory" model="new StoryVM()"/>

<partial name="Home/_PostDeleteCfm" />
<script>
    function openPostDeleteCfm(postId) {

        console.log('Selected post id:', postId); // Fix the console.log syntax
        UIkit.dropdown('.post-options-dropdown').hide(0); // Hide the dropdown if it's open')
        document.getElementById("deleteConfirmationPostId").value = postId; // Ensure the element with ID "postId" exists
        UIkit.modal("#postDeleteDialog").show(); // Ensure the modal with ID "postDeleteDialog" exists
    }
</script>